# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/loyalstamp?sslmode=require"

# Secret used to HMAC-hash coupon codes. Generate with: openssl rand -hex 32
CODE_HMAC_SECRET="replace-with-long-random-string"

# Secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-another-long-random-string"

# Rate limiting (claim attempts)
CLAIM_MAX_FAILED_ATTEMPTS="5"
CLAIM_LOCKOUT_MINUTES="15"
